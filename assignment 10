3. from flask import Flask, jsonify

app = Flask(__name__)

def check_if_prime(n):
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

@app.route("/prime_number/<int:number>")
def prime_number(number):
    response = {
        "Number": number,
        "isPrime": check_if_prime(number)
    }
    
    return jsonify(response)

if __name__ == "__main__":
    app.run(use_reloader=True, host='127.0.0.1', port=5000)
4. from flask import Flask, jsonify
import json
import os

app = Flask(__name__)

script_dir = os.path.dirname(os.path.abspath(__file__))
json_path = os.path.join(script_dir, 'airports.json')

with open(json_path, 'r') as f:
    airports = json.load(f)

@app.route('/airport/<string:icao>')
def get_airport(icao):
    # Search for the airport
    airport = next((a for a in airports if a['icao'].upper() == icao.upper()), None)
     
    if airport:
        result = {
            "icao": airport["icao"],
            "name": airport["name"],
            "city": airport["municipality"], 
            "country": airport["iso_country"] 
        }
        return jsonify(result)
    else:
        # 404 Error if not found
        return jsonify({"error": "Airport not found"}), 404

if __name__ == '__main__':
    app.run(use_reloader=True, host='127.0.0.1', port=5000)
