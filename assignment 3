 def get_middle(text: str) -> str:
    """Extracts the middle one or two characters from a string."""
    if not text:
        return ""

    length = len(text)
    mid = length // 2

    if length % 2 == 0:
        return text[mid - 1 : mid + 1]
    
    return text[mid]

if __name__ == "__main__":
    user_input = input("Enter some stuff: ").strip()
    result = get_middle(user_input)
    print(f"Middle character(s): '{result}'")
