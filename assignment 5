import re

def hide_phone_numbers(text):
    pattern = r"\+84\d+|\b\d{10}\b"
    return re.sub(pattern, "[REDACTED]", text)

input_text = "You may reach Mr. Atkinson through his office number: +842439999999 during work hours, or his cell phone number: 0987654321,"
output_text = hide_phone_numbers(input_text)

